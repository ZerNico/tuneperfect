{
  "name": "@tuneperfect/game",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "build": "vite build && bun run build:electron && bun run native:build:release",
    "dev:vite": "vite",
    "build:vite": "vite build",
    "build:electron": "bun scripts/build-electron.ts",
    "native:build": "napi build --platform --manifest-path native/Cargo.toml --output-dir native --js index.cjs --dts index.d.ts",
    "native:build:release": "bun run native:build --release",
    "package:dir": "bun scripts/package.ts --dir",
    "typecheck": "tsc --noEmit -p electron/tsconfig.json && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "bun scripts/package.ts",
    "native:types": "cargo test --manifest-path native/Cargo.toml typescript"
  },
  "dependencies": {
