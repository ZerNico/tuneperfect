VITE_API_URL=https://api.tuneperfect.localhost
VITE_APP_URL=https://app.tuneperfect.localhost
VITE_POSTHOG_TOKEN=
# Set to 1 to log native-call and frame timings when a song ends (see src/lib/perf.ts)
VITE_PERF=

# Build-time settings for the in-app updater (packaged builds only; CI sets them)
# TUNEPERFECT_UPDATE_ENDPOINT=https://api.example.org/v1.0/updates/electron/{{target}}/{{arch}}/{{current_version}}
# TUNEPERFECT_UPDATE_PUBKEY=<base64 minisign public key, as created by `tauri signer generate`>
