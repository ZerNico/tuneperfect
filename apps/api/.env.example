NODE_ENV=development

PORT=3002

API_URL=https://api.tuneperfect.localhost
APP_URL=https://app.tuneperfect.localhost

JWT_SECRET=secret
COOKIE_DOMAIN=.tuneperfect.localhost
SUPPORT_EMAIL=support@tuneperfect.localhost

EMAIL_SMTP_URL=smtp://localhost:1025
EMAIL_FROM=noreply@tuneperfect.localhost

GOOGLE_CLIENT_ID=some-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=some-client-secret

DISCORD_CLIENT_ID=some-client-id
DISCORD_CLIENT_SECRET=some-client-secret

REDIS_URL=redis://localhost:6379

TRUSTED_PROXY_ENABLED=true
POSTGRES_URL=postgresql://tuneperfect:tuneperfect@localhost:5432/tuneperfect
UPLOADS_PATH=./uploads

STUN_URL=stun:localhost:3478
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
# Must match --static-auth-secret of coturn in docker-compose.dev.yml
TURN_SECRET=tuneperfect-dev-turn-secret
TURN_CREDENTIAL_TTL=86400

POSTHOG_TOKEN=
# Current release; the game update endpoints offer it
VERSION=0.0.0
# owner/repo whose GitHub releases hold the game update files
GITHUB_REPO=
# Last Tauri release of the game. Installed Tauri versions are only offered this one; unset = no updates for them
TAURI_VERSION=
# Tauri targets (darwin, linux, windows) or "all" whose installs migrate to Electron, comma-separated; unset = off
TAURI_MIGRATION_ENABLED=
