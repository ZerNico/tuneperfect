{
  "name": "tuneperfect",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel --force",
    "build": "turbo run build",
    "tuneperfect": "bun run ./node_modules/@tuneperfect/cli/src/index.ts",
    "test": "turbo run test",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@tuneperfect/cli": "workspace:*"
  },
  "devDependencies": {
    "eslint-plugin-solid": "^0.18.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "turbo": "^2.11.5"
  },
  "packageManager": "bun@1.3.14"
}
